      "card":    { "$type": "dimension", "$value": "{primitive.radius.md}", "$description": "Default card and image radius (Figma)." },
      "cardLg":  { "$type": "dimension", "$value": "{primitive.radius.lg}", "$description": "Elements above 200px (brand guide)." },
